# Enforce LF line endings on web assets, configs, and scripts so Workbox MD5
# and SHA-256 integrity digests stay byte-identical across Windows and Linux CI.
*.html text eol=lf
*.js text eol=lf
*.json text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.svg text eol=lf
_redirects text eol=lf
