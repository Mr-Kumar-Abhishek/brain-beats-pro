{
  "name": "brain-beats",
  "version": "1.0.2",
  "description": "Brainwave entrainment web audio application and research blog",
  "bin": {
    "brain-beats-sitemap": "./scripts/generate-sitemap.js"
  },
  "scripts": {
    "test": "node tests/audio-engine.test.js",
    "build:css": "node scripts/build-css.js",
    "build:sitemap": "node scripts/generate-sitemap.js",
    "verify:sitemap": "node scripts/generate-sitemap.js --verify",
    "build:sw": "workbox injectManifest workbox-config.js || true",
    "build:sha256": "node scripts/verify-sha256.js --write",
    "verify:sha256": "node scripts/verify-sha256.js",
    "build": "npm run build:css && npm run build:sitemap && npm run verify:sitemap && npm run build:sw",
    "build:offline": "npm run build && npm test",
    "build:jekyll": "bundle exec jekyll build --config _config.yml,_config.fast.yml --incremental",
    "serve:jekyll": "bundle exec jekyll serve --config _config.yml,_config.fast.yml --host 127.0.0.1 --port 4000 --incremental --no-watch",
    "deploy:netlify:preview": "npx --yes netlify-cli deploy --dir=_site"
  },
  "dependencies": {
    "glob": "^13.0.6"
  },
  "devDependencies": {
    "inquirer": "^13.4.2",
    "sass": "^1.104.1",
    "tmp": "^0.2.6",
    "workbox-cli": "^7.4.1"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "overrides": {
    "tmp": "^0.2.6"
  }
}
